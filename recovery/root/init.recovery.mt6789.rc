on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

on fs
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice

on post-fs
    start mtk-plpath-utils

service mtk-plpath-utils /system/bin/mtk-plpath-utils
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0
